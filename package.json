{
  "name": "mjini-digital",
  "version": "1.0.0",
  "description": "Website Developers in Nairobi, Kenya",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm run build && npm run start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@payloadcms/admin-bar": "3.87.0",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/live-preview-react": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/plugin-form-builder": "3.87.0",
    "@payloadcms/plugin-mcp": "3.87.0",
    "@payloadcms/plugin-nested-docs": "3.87.0",
    "@payloadcms/plugin-redirects": "3.87.0",
    "@payloadcms/plugin-search": "3.87.0",
    "@payloadcms/plugin-seo": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "motion": "^13.0.0",
    "next": "16.2.6",
    "next-share": "^0.27.0",
    "next-sitemap": "^4.2.3",
    "payload": "3.87.0",
    "payload-plugin-mcp": "^1.4.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
